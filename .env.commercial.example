# Test-only values must be chosen explicitly. No credentials or commercial price included.
COMMERCIAL_MODE=disabled
COMMERCIAL_AMOUNT_MINOR=
COMMERCIAL_CURRENCY=mxn
COMMERCIAL_INTERVAL=month
COMMERCIAL_PLAN_NAME=Plan inicial
COMMERCIAL_MAX_USERS=5
COMMERCIAL_TERMS_VERSION=draft-2026-10-05
COMMERCIAL_LEGAL_APPROVED=false
COMMERCIAL_LIVE_APPROVED=false
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
RESEND_API_KEY=
MAIL_FROM=
FRONTEND_URL=http://localhost:19006
EXPO_PUBLIC_API_URL=https://proyectoerp-api.onrender.com/api/v1
# MongoDB must be a replica set. Existing .env.example covers JWT and connection settings.
# ALLOW_PRIVILEGED_REGISTER is ignored outside development/test; never enable it for public testing.
ALLOW_PRIVILEGED_REGISTER=false
