NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://localhost:27017/erp

# Seguridad: en NODE_ENV=production estos valores son OBLIGATORIOS,
# deben tener >= 32 caracteres, ser distintos entre sí y distintos
# a los valores de desarrollo (el backend no arranca si no se cumple).
JWT_SECRET=dev-secret-change-me-32-chars-minimum
JWT_REFRESH_SECRET=dev-refresh-change-me-32-chars-min
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES_DAYS=7

# Registro público privilegiado (elegir role/companyId en /auth/register).
# Por defecto SOLO está permitido en NODE_ENV=test.
# Ponlo a true solo en entornos de desarrollo controlados; NUNCA en producción.
ALLOW_PRIVILEGED_REGISTER=false

FRONTEND_URL=http://localhost:19006
# Lista separada por comas. En produccion agrega aqui el dominio de Cloudflare
# Pages y cualquier dominio personalizado, siempre sin ruta /api.
CORS_ORIGINS=http://localhost:19006,http://localhost:8081

# Se usa durante el build de Expo/Cloudflare Pages (incluye /api/v1).
EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1
