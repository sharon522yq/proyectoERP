{
  "name": "erp-frontend",
  "version": "1.0.0",
  "private": true,
  "description": "ERP frontend — React Native + Web (Expo)",
  "main": "App.js",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "android": "expo run:android",
    "prebuild:android": "npx expo prebuild --platform android --clean",
    "export:web": "expo export --platform web --output-dir dist --clear",
    "deploy:cloudflare": "npx --yes wrangler@4 deploy",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "@expo/metro-runtime": "~3.2.3",
    "axios": "^1.7.2",
    "expo": "^51.0.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-native": "^0.74.0",
    "react-native-web": "^0.19.0"
  }
}
