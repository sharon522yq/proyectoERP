{
  "name": "erp-frontend",
  "version": "1.0.0",
  "private": true,
  "description": "ERP frontend — React Native + Web (Expo)",
  "main": "App.js",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "android": "expo run:android",
    "prebuild:android": "npx expo prebuild --platform android --clean",
    "export:web": "npx expo export --platform web",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "@expo/metro-runtime": "~3.2.3",
    "axios": "^1.7.2",
    "expo": "^51.0.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-native": "0.74.5",
    "react-native-web": "~0.19.10",
    "typescript": "^7.0.2"
  }
}
