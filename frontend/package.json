{
  "name": "erp-frontend",
  "version": "1.0.0",
  "private": true,
  "description": "ERP frontend — React Native + Web (Expo)",
  "main": "App.js",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "android": "expo run:android",
    "prebuild:android": "npx expo prebuild --platform android --clean",
    "export:web": "npx expo export --platform web",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.16",
    "axios": "^1.7.2",
    "expo": "~57.0.26",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-web": "^0.21.2",
    "typescript": "~6.0.3"
  }
}
